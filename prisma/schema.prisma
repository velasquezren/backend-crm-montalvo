// Fuente única de verdad del modelo de datos — CRM_MANIFESTO.md (frontend) §1.1.
// No duplicar estos tipos a mano en ningún otro archivo del backend o frontend.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  /// Manda sobre todo: gestiona agentes (les asigna el código de empresa) e
  /// importa el Excel de la planilla. Cubre todo lo que puede hacer un ADMIN.
  SUPER_ADMIN
  ADMIN
  AGENTE
}

enum CategoriaCliente {
  PROSPECTO
  BRONZE
  SILVER
  GOLD
}

enum OrigenLead {
  FACEBOOK_LEAD_AD
  FACEBOOK_COMENTARIO
  FACEBOOK_MENSAJE
  INSTAGRAM_LEAD_AD
  INSTAGRAM_COMENTARIO
  INSTAGRAM_MENSAJE
  WHATSAPP_DIRECTO
  PRESENCIAL
  IMPORTACION /// carga masiva desde datos históricos (ej. FileMaker), sin interacción real todavía
}

enum EstadoVenta {
  GANADA
  EN_PROCESO
  PERDIDA
}

enum EstadoLead {
  NUEVO
  CONTACTADO
  CONVERTIDO
  PERDIDO
}

enum DireccionMensaje {
  ENTRANTE
  SALIENTE
}

model Usuario {
  id                String                 @id @default(uuid())
  nombre            String
  email             String                 @unique
  passwordHash      String
  rol               Rol                    @default(AGENTE)
  activo            Boolean                @default(true)
  foto              String?
  /// Identificador que usa la empresa para esta persona (el `vendedora_pk` de
  /// FileMaker, ej. Pe2455). Es la ÚNICA vía por la que la planilla de comisiones
  /// reconoce a qué agente pertenece cada venta: al ser único y venir en el propio
  /// Excel, no hace falta vincular nada a mano ni adivinar por el nombre.
  /// Solo un SUPER_ADMIN puede asignarlo.
  codigo            String?                @unique @db.VarChar(40)
  clientes          Cliente[]              @relation("AgenteAsignado")
  intereses         Interes[]
  leads             Lead[]
  conversaciones    Conversacion[]
  ventas            Venta[]
  plantillas        PlantillaAgente[]
  recursosMemoria   RecursoMemoriaAgente[]
  pushSubscriptions PushSubscription[]
  tiposCambioCorregidos TipoCambioDiario[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model Cliente {
  id        String           @id @default(uuid())
  nombre    String
  telefono  String           @unique
  email     String?
  categoria CategoriaCliente @default(PROSPECTO)
  agente    Usuario?         @relation("AgenteAsignado", fields: [agenteId], references: [id])
  agenteId  String?
  /// Identificador del paciente en FileMaker (columna `pk`: Pac1897). Es la MISMA
  /// clave que `VentaImportada.pac`, así que el historial de servicios de un
  /// paciente es un join indexado y no un escaneo sobre JSON.
  /// Se guarda siempre en MAYÚSCULAS: FileMaker exporta `Pac1897` en el maestro
  /// de pacientes y `PAC50660` en el de ventas, y sin normalizar no cruzarían.
  pac       String?          @unique @db.VarChar(20)
  // ── Ficha del paciente (origen: FileMaker) ──────────────────────────
  // Columnas propias y no un JSON: el listado las trae sin coste extra, la
  // ficha abre sin pedir nada más, y se pueden filtrar y agregar en SQL para
  // responder preguntas de negocio.

  /// Fuente de verdad de la edad. NO se guarda la edad en número: el volcado de
  /// FileMaker traía la edad del día de la exportación y hoy miente hasta en 18
  /// años. La edad se calcula al mostrarla; esta fecha nunca caduca.
  fechaNacimiento DateTime? @db.Date
  sexo            String?   @db.VarChar(1)
  ocupacion       String?   @db.VarChar(80)
  ci              String?   @db.VarChar(40)
  ciLugar         String?   @db.VarChar(30)
  estadoCivil     String?   @db.VarChar(25)
  direccion       String?   @db.VarChar(200)
  nacionalidad    String?   @db.VarChar(50)
  telefonoFijo    String?   @db.VarChar(30)
  nit             String?   @db.VarChar(45)
  /// Saldo pendiente que arrastraba el paciente en el sistema antiguo.
  saldoTotal      Decimal?  @db.Decimal(12, 2)
  /// Dónde trabaja (`EmpTrab` de FileMaker).
  empresaTrabajo  String?   @db.VarChar(120)
  /// Persona de referencia o contacto de emergencia, con su teléfono.
  contactoRef     String?   @db.VarChar(120)
  telefonoRef     String?   @db.VarChar(30)
  telefonoOficina String?   @db.VarChar(30)
  /// Visitas acumuladas en el sistema antiguo (`Movimientos`). Es el mejor
  /// indicador de recurrencia que trae el volcado: sirve para segmentar quién
  /// ya es paciente fiel y quién vino una sola vez.
  visitasPrevias  Int?

  /// Residuo del volcado original (contadores internos de FileMaker). Se
  /// conserva por trazabilidad pero NO se envía en los listados: son 19 claves
  /// que encarecían cada página sin que nadie las leyera.
  datosExtra     Json?
  intereses      Interes[]
  leads          Lead[]
  conversaciones Conversacion[]
  ventas         Venta[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  // `Cliente_saldoTotal_idx` es parcial (`WHERE "saldoTotal" > 0`) y el lenguaje de
  // Prisma no puede expresar un WHERE: vive solo en el SQL de la migración. Prisma
  // no lo ve y por eso tampoco intenta borrarlo.

  @@index([categoria])
  @@index([nombre])
  @@index([email])
  @@index([agenteId])
  @@index([updatedAt])
  // Índices de la ficha (creados en `20260801092107_ficha_paciente_columnas` y
  // `20260801103453_cliente_datos_filemaker_restantes`). Se declaran aquí para que
  // el schema refleje la base real: sin esto `migrate dev` los veía como sobrantes
  // y generaba una migración que los BORRABA.
  @@index([fechaNacimiento])
  @@index([ocupacion])
  @@index([visitasPrevias(sort: Desc)])
  // Búsqueda por texto. Un B-tree no sirve para `ILIKE '%texto%'` —el comodín
  // inicial lo inutiliza— así que estos son GIN de trigramas. Sin ellos, cada
  // tecleo en el buscador era un Seq Scan sobre 15.000+ filas (41 ms → 0,2 ms).
  // Se declaran aquí, y no solo en el SQL, porque Prisma SÍ los ve: si faltaran,
  // el próximo `migrate dev` generaría una migración borrándolos.
  @@index([nombre(ops: raw("gin_trgm_ops"))], type: Gin, map: "Cliente_nombre_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Cliente_email_trgm_idx")
  @@index([telefono(ops: raw("gin_trgm_ops"))], type: Gin, map: "Cliente_telefono_trgm_idx")
}

model Interes {
  id                String     @id @default(uuid())
  cliente           Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId         String
  descripcion       String
  categoriaProducto String?
  origen            OrigenLead
  agente            Usuario?   @relation(fields: [agenteId], references: [id])
  agenteId          String?
  createdAt         DateTime   @default(now())

  @@index([clienteId])
}

model Lead {
  id         String     @id @default(uuid())
  cliente    Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId  String
  origen     OrigenLead
  estado     EstadoLead @default(NUEVO)
  /// `leadgen_id` de Meta Lead Ads: **uno por persona que rellena el formulario**.
  /// Es único porque es la clave de idempotencia con la que `procesarLeadMeta`
  /// deduplica los reintentos del webhook. NO metas aquí el id de un anuncio.
  metaLeadId String?    @unique
  /// Anuncio por el que entró: `referral.source_id` en Click-to-WhatsApp, o
  /// `ad_id` de Graph API en un Lead Ad de formulario instantáneo — mismo
  /// significado en los dos casos ("qué anuncio trajo a esta persona"), así que
  /// comparten columna en vez de duplicarla.
  /// **No es único a propósito**: un mismo anuncio trae a muchas pacientes, que
  /// es justo para lo que se paga una campaña. Indexado para poder contar
  /// cuántos leads trajo cada anuncio.
  anuncioId  String?    @db.VarChar(64)
  /// Por qué se perdió. Solo tiene sentido con `estado = PERDIDO`; se limpia si
  /// el lead vuelve a moverse a otro estado — mismo criterio que
  /// `VentaImportada.motivoExclusion`: mover (o dejar de mover) una oportunidad
  /// sin dejar dicho el motivo es irrecuperable a los tres meses.
  motivoPerdida String? @db.VarChar(200)
  agente     Usuario?   @relation(fields: [agenteId], references: [id])
  agenteId   String?
  /// Ventas que citan a este lead como su origen (`Venta.leadId`). No toda
  /// venta nace de un lead trabajado en el pipeline, así que la relación es
  /// opcional del lado de `Venta`.
  ventas     Venta[]
  createdAt  DateTime   @default(now())

  @@index([anuncioId])
  @@index([clienteId])
  @@index([estado])
  @@index([agenteId])
  @@index([createdAt])
  @@index([origen, estado])
  @@index([agenteId, estado])
}

model Conversacion {
  id        String    @id @default(uuid())
  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  /// Único: un inbox de WhatsApp tiene UN hilo por contacto (igual que la app
  /// de WhatsApp). Además cierra la race de dos webhooks entrantes simultáneos
  /// creando dos conversaciones para el mismo cliente — ver procesarEntrante.
  clienteId String    @unique
  agente    Usuario?  @relation(fields: [agenteId], references: [id])
  agenteId  String?
  mensajes  Mensaje[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// True mientras la paciente espera respuesta de una PERSONA: lo último que
  /// pasó fue un mensaje suyo, o el acuse automático fuera de horario (que no
  /// cuenta como respuesta). Es la pestaña "Sin responder" del inbox.
  ///
  /// Está desnormalizado a propósito. La condición real —"el ÚLTIMO mensaje es
  /// ENTRANTE o automático"— no se puede expresar en un `where` de Prisma sin
  /// una subconsulta correlacionada por fila, así que la pestaña se resolvía en
  /// el navegador sobre las conversaciones ya cargadas. Eso obligaba a cargarlas
  /// TODAS, que es la raíz del tope de 500 que escondía chats en silencio.
  ///
  /// Se escribe en las mismas cuatro transacciones que ya bumpean `updatedAt`
  /// al crear un mensaje (enviarMensaje, enviarPlantilla, procesarEntrante,
  /// guardarMensajeAutomatico). Si alguna vez agregas un quinto camino que
  /// cree un Mensaje, escribe también este campo o la pestaña mentirá en
  /// silencio. Los cuatro casos están fijados en
  /// `conversaciones.integracion.spec.ts`, bloque "la pestaña Sin responder se
  /// mantiene al crear cada mensaje".
  esperandoRespuesta Boolean @default(false)

  @@index([agenteId])
  @@index([updatedAt])
  @@index([agenteId, updatedAt])
  /// Sirve al filtro y al contador de la pestaña "Sin responder" a la vez.
  @@index([esperandoRespuesta, updatedAt])
}

model Mensaje {
  id             String           @id @default(uuid())
  conversacion   Conversacion     @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  conversacionId String
  direccion      DireccionMensaje
  /// Para media, `contenido` guarda el pie de foto (caption) o el nombre del archivo; puede ir vacío.
  contenido      String
  whatsappMsgId  String?          @unique
  /// Tipo de contenido. TEXTO por defecto; el resto llega por el webhook de media.
  tipo           TipoMensaje      @default(TEXTO)
  /// Clave del objeto en R2 (Cloudflare). Null mientras se descarga/sube en segundo plano.
  mediaKey       String?
  /// MIME real del archivo (image/jpeg, application/pdf, audio/ogg…).
  mediaMime      String?
  /// Nombre original del archivo (documentos). Null para imágenes/audio.
  mediaNombre    String?
  /// Solo aplica a SALIENTE — el paciente no tiene "estado de entrega" hacia nosotros.
  /// Ticks estilo WhatsApp: ENVIADO al crear, luego lo actualiza la respuesta de Meta
  /// (FALLIDO) o el webhook de `statuses` (ENTREGADO/LEIDO).
  estadoEnvio    EstadoMensaje?
  entregadoEn    DateTime?
  leidoEn        DateTime?
  /// true = lo mandó el sistema (acuse fuera de horario), no una persona.
  ///
  /// Existe por el inbox, no por trazabilidad: la pestaña "Sin responder" detecta
  /// que nadie contestó mirando si el último mensaje es del paciente. Sin esta
  /// marca, un acuse automático convertiría el último mensaje en saliente y la
  /// conversación DESAPARECERÍA de esa pestaña — el lunes nadie sabría quién
  /// escribió el fin de semana. La automatización habría empeorado, en silencio,
  /// justo el problema que venía a resolver.
  automatico     Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@index([conversacionId, createdAt])
}

enum TipoMensaje {
  TEXTO
  IMAGEN
  DOCUMENTO
  AUDIO
  VIDEO
  STICKER
}

enum EstadoMensaje {
  ENVIADO
  ENTREGADO
  LEIDO
  FALLIDO
}

model Venta {
  id                String      @id @default(uuid())
  cliente           Cliente     @relation(fields: [clienteId], references: [id])
  clienteId         String
  agente            Usuario     @relation(fields: [agenteId], references: [id])
  agenteId          String
  producto          String
  /// Montos en bolivianos (Bs) — moneda única del sistema, ver shared/pipes/moneda.pipe.ts en el frontend.
  monto             Decimal     @db.Decimal(12, 2)
  estado            EstadoVenta @default(GANADA)
  metodoPago        String?     @db.VarChar(50)
  comprobante       String?     @db.VarChar(100)
  comprobanteKey    String?     @db.VarChar(255)
  comprobanteMime   String?     @db.VarChar(100)
  comprobanteNombre String?     @db.VarChar(255)
  medico            String?     @db.VarChar(120)
  modulo            String?     @db.VarChar(60)
  notas             String?     @db.Text
  /// Lead que originó esta venta, si el agente lo indicó al registrarla.
  /// Opcional a propósito: hay ventas presenciales o históricas sin un lead
  /// trabajado antes en el pipeline. Sirve para saber de qué campaña/anuncio
  /// vino una venta real (vía `Lead.anuncioId`/`origen`) en vez de asumir que
  /// TODOS los leads abiertos del cliente se cerraron por esta venta —
  /// ver `LeadsService.marcarConvertidos`.
  lead              Lead?       @relation(fields: [leadId], references: [id])
  leadId            String?
  /// Por qué se perdió. Solo tiene sentido con `estado = PERDIDA`; se limpia si
  /// la venta vuelve a moverse a otro estado — mismo criterio que
  /// `Lead.motivoPerdida` y `VentaImportada.motivoExclusion`.
  motivoPerdida     String?     @db.VarChar(200)
  createdAt         DateTime    @default(now())

  @@index([clienteId])
  @@index([agenteId])
  @@index([estado])
  @@index([createdAt])
  @@index([agenteId, estado])
  @@index([leadId])
}

model AuditLog {
  id        String   @id @default(uuid())
  entidad   String
  entidadId String
  accion    String
  usuarioId String?
  cambios   Json?
  createdAt DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([createdAt])
}

model PlantillaAgente {
  id        String   @id @default(uuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  titulo    String
  atajo     String?
  contenido String
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
  @@index([atajo])
}

enum TipoRecursoMemoria {
  TEXTO
  IMAGEN
  DOCUMENTO
  ENLACE
}

enum CategoriaRecursoMemoria {
  GENERAL
  RESPUESTA_RAPIDA
  PROMOCION
  PRECIOS
  PRODUCTO_TRATAMIENTO
  INSTRUCCION_INTERNA
}

model RecursoMemoriaAgente {
  id        String  @id @default(uuid())
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String

  titulo    String                  @db.VarChar(120)
  contenido String?                 @db.Text
  tipo      TipoRecursoMemoria      @default(TEXTO)
  categoria CategoriaRecursoMemoria @default(GENERAL)
  atajo     String?                 @db.VarChar(35)

  mediaKey    String? @db.VarChar(255)
  mediaMime   String? @db.VarChar(100)
  mediaNombre String? @db.VarChar(255)
  pesoBytes   Int     @default(0)

  tags     String[] @default([])
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId, categoria])
  @@index([usuarioId, tipo])
  @@index([usuarioId, atajo])
  @@index([usuarioId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// ── Planilla Mensual de Comisiones (Importación FileMaker) ───────────────
// Dominio SEPARADO de `Venta` (que modela la venta puntual en el CRM).
// Aquí vive la planilla mensual consolidada que administración importa desde
// el Excel de FileMaker: periodos, tarifas, vendedoras, médicos, reglas de
// clasificación y liquidación en USD/Bs.
// Nada de esto toca los modelos anteriores.
// ═══════════════════════════════════════════════════════════════════════════

// Origen del contacto: con recursos de la empresa o propios de la vendedora.
enum CanalVenta {
  EMPRESA
  PROPIO
}

enum UnidadNegocio {
  MATERNIDAD
  RA
  VARIOS
}

// Clasificación de comisión de una venta (CLASIF en la planilla de Excel).
enum ClasifComision {
  PLANPAQ
  PLANNIN
  CIRUGIA
  CONSULTA
  LAB
  ECOGRAFIA
  OTROSS
  CAMPANA
  PROMOCION
}

// A = planes · B = cirugías y RA · C = consultas, labs, ecografías y otros.
enum TipoComision {
  A
  B
  C
}

enum NivelPlan {
  BRONCE
  SILVER
  GOLD
}

enum TipoVendedora {
  JEFA
  VENDEDORA
}

enum AreaVendedora {
  EJECUTIVA
  RA
  PUBLICIDAD
}

enum EstadoPeriodo {
  BORRADOR
  CALCULADO
  CERRADO
}

// Un mes de liquidación. Único por año+mes: reimportar reemplaza sus filas.
model PeriodoComision {
  id            String        @id @default(uuid())
  anio          Int
  mes           Int
  /// Tipo de cambio USD→BOB del mes (columna `tc` del Excel).
  tipoCambio    Decimal       @db.Decimal(10, 4)
  estado        EstadoPeriodo @default(BORRADOR)
  archivoNombre String?       @db.VarChar(255)
  filasTotales  Int           @default(0)
  filasValidas  Int           @default(0)
  importadoPor  String?
  calculadoEn   DateTime?
  /// Foto de las reglas con las que se liquidó este mes.
  ///
  /// Tarifas, niveles, parámetros y objetivos son GLOBALES: cambiarlos hoy
  /// cambia lo que daría cualquier recálculo, también el de un mes viejo. Sin
  /// esta foto, en marzo nadie puede responder "¿con qué reglas se pagó enero?",
  /// porque los números están guardados pero las reglas ya no son las mismas.
  ///
  /// Se escribe en cada cálculo y se pisa al recalcular: describe el resultado
  /// que hay ahora, no el historial de intentos —eso vive en AuditLog—.
  configuracionUsada Json?

  ventas     VentaImportada[]
  resultados ResultadoComision[]
  objetivos  ObjetivoComision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([anio, mes])
  @@index([anio, mes])
}

// Una fila del Excel: columnas crudas + lo que dedujo el clasificador.
model VentaImportada {
  id        String          @id @default(uuid())
  periodo   PeriodoComision @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  periodoId String

  // ── Columnas crudas de FileMaker (se guardan tal cual para trazabilidad) ──
  fecha             DateTime?
  modulo            String?   @db.VarChar(40)
  codOrigen         String?   @db.VarChar(40)
  estadoPlan        String?   @db.VarChar(40)
  codItem           String?   @db.VarChar(40)
  detalle           String    @db.VarChar(300)
  pac               String?   @db.VarChar(40)
  paciente          String?   @db.VarChar(200)
  medicoPk          String?   @db.VarChar(40)
  medico            String?   @db.VarChar(200)
  vendedoraPk       String?   @db.VarChar(40)
  vendedoraNombre   String?   @db.VarChar(200)
  captacion         String?   @db.VarChar(40)
  seguro            String?   @db.VarChar(60)
  promocion         String?   @db.VarChar(20)
  precio            Decimal   @db.Decimal(12, 2)
  anticipoPlan      Decimal?  @db.Decimal(12, 2)
  tc                Decimal?  @db.Decimal(10, 4)
  obs               String?   @db.Text
  clasificacionPlan String?   @db.VarChar(80)

  // ── Derivados por el clasificador (admin puede sobreescribirlos) ──
  canal         CanalVenta
  /// Base de cálculo: SIEMPRE precio × 0,87. El anticipo no la cambia — un plan
  /// comisiona una sola vez, por su precio entero, sin importar cuánto se pagó
  /// ese mes ni cuánto queda debiendo.
  ingresoNeto   Decimal        @db.Decimal(12, 2)
  unidadNegocio UnidadNegocio
  clasif        ClasifComision
  tipo          TipoComision
  nivel         NivelPlan?

  /// false = no entra al cálculo (precio 0, plan no aprobado, etc.).
  comisionable     Boolean @default(true)
  motivoExclusion  String? @db.VarChar(200)
  /// true = ni el diccionario ni los heurísticos reconocieron el servicio.
  /// Comisiona provisionalmente como OTROSS, pero debe revisarse a mano.
  requiereRevision Boolean @default(false)
  /// true = un admin corrigió la clasificación a mano; no se pisa al recalcular.
  ajustadaManual   Boolean @default(false)

  /// Solo para planes (PLANPAQ/PLANNIN). Decide si ESTE plan concreto comisiona
  /// cuando la vendedora superó su objetivo — porque solo comisionan los que lo
  /// superan, y hay que saber cuáles.
  ///
  /// `null` = lo elige el sistema (base más baja primero, que es lo que hizo
  /// administración); `true`/`false` = decisión manual, y esa manda. En la
  /// planilla era la columna `PLANPAG COMISIONABLE`, escrita a mano fila por fila.
  comisionaPlan Boolean?

  vendedora   VendedoraComision? @relation(fields: [vendedoraId], references: [id])
  vendedoraId String?

  createdAt DateTime @default(now())

  @@index([periodoId])
  @@index([periodoId, vendedoraId])
  @@index([periodoId, clasif])
  @@index([periodoId, comisionable])
  @@index([periodoId, requiereRevision])
  // Se buscan al revisar la clasificación de un mes; ver la nota de Cliente.
  @@index([detalle(ops: raw("gin_trgm_ops"))], type: Gin, map: "VentaImportada_detalle_trgm_idx")
  @@index([paciente(ops: raw("gin_trgm_ops"))], type: Gin, map: "VentaImportada_paciente_trgm_idx")
  // El historial clínico agrupa por paciente y por médico sobre TODOS los
  // periodos, no dentro de uno: los índices compuestos de arriba empiezan por
  // `periodoId` y no le sirven. Hoy son 1.287 filas y da igual, pero la tabla
  // suma ~450 al mes y en dos años serían 11.000.
  @@index([pac])
  @@index([medicoPk])
}

//
// * Persona que comisiona. Se autocrea al importar (por `vendedora_pk`) con
// * `configurada = false` para que administración le fije tipo, área y sueldo.
//
/// Quien atiende al paciente. Sale de `medico_pk` del Excel de FileMaker.
///
/// **Un médico NO es un usuario.** Son cosas distintas y a propósito:
///  · `Medico`  = un rol clínico. Existe para poder medir producción por
///                profesional, aunque esa persona nunca entre al sistema.
///  · `Usuario` = alguien que inicia sesión. Solo lo necesitan los pocos que
///                de verdad usan el CRM (hoy, el Dr. Montalvo).
///
/// Se unen por `codigo`, que es la misma clave que `Usuario.codigo` y que
/// `VendedoraComision.codigo`: FileMaker identifica a la PERSONA con ese código,
/// no a su función. Por eso una misma persona puede ser médica y vendedora a la
/// vez sin duplicarse, y por eso el prefijo no dice nada del rol: `Dr1970` es
/// vendedora y `Pe2308` es el técnico de rayos X.
///
/// El nombre no sirve como identidad: el mismo `Dr1946` aparece en el Excel como
/// "Azogue Rivera Claudia María" y como "Claudia María Azogue Rivera".
model Medico {
  id     String @id @default(uuid())
  codigo String @unique @db.VarChar(40)
  /// Última grafía vista en el Excel; se actualiza si cambia.
  nombre String @db.VarChar(200)

  /// Especialidad u observaciones que administración quiera anotar.
  especialidad String? @db.VarChar(120)

  /// false = dejó de atender. No se borra: sus atenciones históricas siguen
  /// necesitando a quién apuntar.
  activo Boolean @default(true)

  /// false = lo creó solo el importador y administración aún no lo revisó.
  configurado Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo])
}

model VendedoraComision {
  id          String        @id @default(uuid())
  /// `vendedora_pk` del Excel (ej. Pe2455). Es la MISMA clave que `Usuario.codigo`:
  /// con eso el sistema sabe a qué agente del CRM corresponde, sin vincular a mano.
  codigo      String        @unique @db.VarChar(40)
  nombre      String        @db.VarChar(200)
  tipo        TipoVendedora @default(VENDEDORA)
  area        AreaVendedora @default(EJECUTIVA)
  sueldoBase  Decimal       @default(0) @db.Decimal(12, 2)
  activa      Boolean       @default(true)
  /// false = autocreada al importar y aún sin revisar por administración.
  configurada Boolean       @default(false)

  ventas     VentaImportada[]
  resultados ResultadoComision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activa])
}

//
// * Diccionario configurable `detalle` → clasificación. Se evalúa por `prioridad`
// * ascendente ANTES de los heurísticos del clasificador, así administración
// * puede fijar a mano cualquier servicio nuevo sin tocar código.
//
model ReglaClasificacion {
  id            String         @id @default(uuid())
  /// Texto a buscar en `detalle` (sin distinguir mayúsculas ni acentos).
  patron        String         @db.VarChar(200)
  /// true = el detalle debe coincidir exacto; false = basta que lo contenga.
  exacto        Boolean        @default(false)
  /// Limita la regla a un módulo del Excel (CONSULTA, LABORATORIO…).
  modulo        String?        @db.VarChar(40)
  clasif        ClasifComision
  nivel         NivelPlan?
  unidadNegocio UnidadNegocio?
  prioridad     Int            @default(100)
  activa        Boolean        @default(true)
  notas         String?        @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activa, prioridad])
}

// ── Configuración editable por administración ───────────────────────────

/// TIPO A. `clave`: BRONCE | SILVER | GOLD (maternidad) o PLANNIN (planes varios).
model TarifaPlan {
  id         String  @id @default(uuid())
  clave      String  @unique @db.VarChar(20)
  pctEmpresa Decimal @db.Decimal(6, 3)
  pctPropio  Decimal @db.Decimal(6, 3)
}

/// TIPO C. Porcentaje por clasificación y canal.
model TarifaServicio {
  id         String         @id @default(uuid())
  clasif     ClasifComision @unique
  pctEmpresa Decimal        @db.Decimal(6, 3)
  pctPropio  Decimal        @db.Decimal(6, 3)
}

/// TIPO B (ejecutivas): escala por monto acumulado de cirugías en el mes.
model NivelCirugia {
  id         String  @id @default(uuid())
  nivel      Int     @unique
  montoDesde Decimal @db.Decimal(12, 2)
  montoHasta Decimal @db.Decimal(12, 2)
  pctEmpresa Decimal @db.Decimal(6, 3)
  pctPropio  Decimal @db.Decimal(6, 3)
}

/// TIPO B (coordinadoras RA): tarifa fija en USD por procedimiento.
model TarifaRA {
  id            String  @id @default(uuid())
  procedimiento String  @unique @db.VarChar(120)
  montoEmpresa  Decimal @db.Decimal(12, 2)
  montoPropio   Decimal @db.Decimal(12, 2)
  /// true = los montos son porcentajes sobre la base, no USD fijos (Labs RA).
  esPorcentaje  Boolean @default(false)
}

/// TIPO A (RA, ejecutivas): escala por el EXCEDENTE sobre `MONTOBJETIVO` de la
/// suma de ingreso neto de planes de maternidad + ventas del área RA que no son
/// cirugía (consulta/laboratorio/ecografía/otros). El % resultante se aplica
/// solo a la porción RA de esa suma — los planes ya cobran su propia tarifa.
///
/// Es una tabla APARTE de `NivelCirugia`, aunque en diciembre 2025 traigan los
/// mismos montos y porcentajes: en la planilla de administración
/// (`CALCULO COMISION DICIEMBRE 2025.xlsx`, hoja PARAMETROS, filas 58-64 y
/// 70-83) son dos tablas copiadas por separado, así que administración puede
/// cambiar una sin que se mueva la otra.
model NivelTipoARA {
  id         String  @id @default(uuid())
  nivel      Int     @unique
  montoDesde Decimal @db.Decimal(12, 2)
  montoHasta Decimal @db.Decimal(12, 2)
  pctEmpresa Decimal @db.Decimal(6, 3)
  pctPropio  Decimal @db.Decimal(6, 3)
}

/// Objetivos mínimos por tipo de vendedora (gatillan la comisión Tipo A y los bonos).
/// Metas del equipo comercial. Hay dos capas:
///  · `periodoId = null` → metas POR DEFECTO, las que rigen mientras nadie diga otra cosa.
///  · `periodoId = X`    → metas propias de ese mes, que pisan a las de por defecto.
///
/// Se modela así y no como un único valor global porque administración sube o
/// baja las metas según la temporada, y una planilla ya liquidada tiene que
/// seguir mostrando con qué meta se calculó. Cambiar la meta de marzo no puede
/// reescribir lo que se pagó en febrero.
model ObjetivoComision {
  id   String        @id @default(uuid())
  tipo TipoVendedora

  periodo   PeriodoComision? @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  periodoId String?

  /// Paquetes/planes de maternidad (PLANPAQ) que hay que SUPERAR para que
  /// empiecen a comisionar. Son dos objetivos distintos y no uno solo: la
  /// planilla los lleva por separado (`PLANPAQTVENDEDORA`=4, `PLANNINVENDEDORA`=1).
  planpaqMinimos     Int
  /// Planes varios / niño sano (PLANNIN). Objetivo propio, casi siempre 1.
  planninMinimos     Int     @default(1)
  montoMensualUsd    Decimal @db.Decimal(12, 2)
  montoTrimestralUsd Decimal @db.Decimal(12, 2)

  /// Un solo juego de metas por tipo y periodo. Ojo: en Postgres los NULL son
  /// distintos entre sí, así que este único NO impide dos filas por defecto del
  /// mismo tipo — eso lo cubre un índice parcial creado en la migración.
  @@unique([tipo, periodoId])
  @@index([periodoId])
}

/// Constantes del cálculo (IVA, factores de bono…), editables sin migración.
model ParametroComision {
  clave       String  @id @db.VarChar(60)
  valor       Decimal @db.Decimal(12, 6)
  descripcion String? @db.VarChar(300)
}

/// Qué valor de la columna `captacion` del Excel cuenta como venta propia.
///
/// Es la diferencia entre cobrar 4,5% y 5,5% (o 1% y 2% en planes), así que no
/// puede vivir hardcodeado: administración cambia los canales sin avisar y hoy
/// el criterio no es obvio — en la planilla, una venta llegada por **Facebook
/// cuenta como EMPRESA**, no como propia. Lo que no esté en esta tabla se trata
/// como EMPRESA, que es la opción conservadora (paga menos).
model MapeoCaptacion {
  /// Valor tal como llega en el Excel, ya normalizado (mayúsculas, sin tildes).
  valor String     @id @db.VarChar(60)
  canal CanalVenta
}

/// Liquidación final de una vendedora en un periodo.
model ResultadoComision {
  id          String            @id @default(uuid())
  periodo     PeriodoComision   @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  periodoId   String
  vendedora   VendedoraComision @relation(fields: [vendedoraId], references: [id])
  vendedoraId String

  // ── Lo vendido en el mes ─────────────────────────────────────────────
  montoVendido Decimal @default(0) @db.Decimal(14, 2)
  /// Monto sin impuestos: es sobre esto que se aplican los porcentajes.
  baseCalculo  Decimal @default(0) @db.Decimal(14, 2)

  // ── Tipo A · planes ──────────────────────────────────────────────────
  // Solo comisionan los planes que SUPERAN el objetivo, así que se guardan
  // los dos números: sin ellos no se le puede explicar a una vendedora por
  // qué cobró lo que cobró.
  planpaqVendidos      Int     @default(0)
  planpaqComisionables Int     @default(0)
  planninVendidos      Int     @default(0)
  planninComisionables Int     @default(0)
  /// Suma de los dos tipos de plan, para no recalcularla en cada reporte.
  planesVendidos       Int     @default(0)
  /// true = generó comisión Tipo A, es decir superó alguno de los dos objetivos.
  cumpleObjetivoPlanes Boolean @default(false)

  // ── Tipo B · cirugías ────────────────────────────────────────────────
  /// El nivel sale de este acumulado y luego se aplica a TODAS las cirugías.
  acumuladoCirugias Decimal @default(0) @db.Decimal(14, 2)
  nivelCirugia      Int?

  // ── Tipo A (RA) · excedente combinado planes + RA ───────────────────
  /// Los dos sumandos de "SUMA MONTO COMISIONABLE" (columna AU de
  /// `BDEjecutivas` en el Excel de administración), guardados por separado
  /// en vez de solo su suma: sin esto no se le puede explicar a una
  /// vendedora ni a administración cuánto vino de sus planes de maternidad
  /// y cuánto de sus ventas RA — antes se calculaban y se descartaban en el
  /// mismo momento, así que el informe solo podía mostrar el resultado
  /// final sin el porqué.
  /// Ingreso neto de planes de maternidad (PLANPAQ + PLANNIN) del mes.
  ingresoMaternidadTipoARA Decimal @default(0) @db.Decimal(14, 2)
  /// Ingreso neto de ventas del área RA que NO son cirugía (consulta,
  /// laboratorio, ecografía, otros) — la cirugía RA ya está en `comisionB`.
  ingresoRATipoARA         Decimal @default(0) @db.Decimal(14, 2)
  /// `ingresoMaternidadTipoARA + ingresoRATipoARA − MONTOBJETIVO` del tipo
  /// de vendedora. Puede ser negativo: significa que no llegó al objetivo y
  /// por tanto `nivelTipoARA` es `null` (columna "NA" del Excel).
  excedenteTipoARA         Decimal @default(0) @db.Decimal(14, 2)
  /// Ahí sale el nivel, comparando el excedente contra la escala. Es
  /// DISTINTA de `comisionA` (planes GOLD/SILVER/BRONCE): esta es la
  /// columna del Excel "COMISIÓN TIPO A (RA)", un cubo aparte que hasta
  /// 2026-08-22 no se calculaba.
  nivelTipoARA     Int?
  comisionTipoARA  Decimal @default(0) @db.Decimal(12, 2)

  // ── Comisiones, en USD ───────────────────────────────────────────────
  comisionA Decimal @default(0) @db.Decimal(12, 2)
  comisionB Decimal @default(0) @db.Decimal(12, 2)
  comisionC Decimal @default(0) @db.Decimal(12, 2)

  // ── Bonos, en USD ────────────────────────────────────────────────────
  /// En la planilla real SIEMPRE va en cero: el pote que genera el equipo se
  /// reparte entre publicidad (ver `bonoPublicidad`). Se conserva la columna
  /// porque la planilla la muestra y porque administración podría decidir
  /// pagárselo a la jefa en el futuro.
  bonoJefatura   Decimal @default(0) @db.Decimal(12, 2)
  /// Parte del pote de jefatura que le toca a cada persona del área PUBLICIDAD.
  bonoPublicidad Decimal @default(0) @db.Decimal(12, 2)
  bonoTrimestral Decimal @default(0) @db.Decimal(12, 2)

  // ── Totales ──────────────────────────────────────────────────────────
  totalUsd    Decimal @default(0) @db.Decimal(12, 2)
  /// `totalUsd` convertido con el TC del periodo.
  totalBob    Decimal @default(0) @db.Decimal(12, 2)
  sueldoBase  Decimal @default(0) @db.Decimal(12, 2)
  /// Lo que la persona se lleva: comisiones y bonos en Bs, más su sueldo.
  totalGanado Decimal @default(0) @db.Decimal(12, 2)

  /// Desglose por clasificación y canal para el reporte por vendedora.
  desglose Json?

  createdAt DateTime @default(now())

  @@unique([periodoId, vendedoraId])
  @@index([periodoId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

enum FuenteTipoCambio {
  /// Traído solo de un espejo público del BCB (no es el BCB en sí — bcb.gob.bo
  /// no publica API, solo Excel/PDF para descargar a mano). Ver `TipoCambioService`.
  AUTOMATICO
  /// Cargado o corregido a mano por un ADMIN — siempre gana sobre un valor automático.
  MANUAL
}

/// Serie histórica del tipo de cambio oficial USD→BOB, un valor por día
/// (`fecha` es la que el BCB marca como vigente, no la fecha en que se guardó
/// la fila). Es la referencia GLOBAL para mostrar montos en dólares en toda la
/// app — el selector Bs/$us del navbar, KPIs, la tabla de Ventas.
///
/// NO es lo mismo que `PeriodoComision.tipoCambio`: ese es el TC de un mes de
/// liquidación ya cerrado (columna del Excel de FileMaker), fijo para siempre
/// aunque este historial seguya creciendo. No unificar los dos: uno liquida
/// comisiones ya calculadas, el otro es la cotización del día a día, y este
/// sigue creciendo aunque aquel se quede fijo.
model TipoCambioDiario {
  fecha             DateTime         @id @db.Date
  valor             Decimal          @db.Decimal(10, 4)
  fuente            FuenteTipoCambio
  actualizadoPor    Usuario?         @relation(fields: [actualizadoPorId], references: [id])
  actualizadoPorId  String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}
