DATABASE_URL="postgresql://usuario:password@localhost:5433/crm?schema=public"
PORT=3001
JWT_SECRET="generar-un-secreto-largo-y-aleatorio"
META_VERIFY_TOKEN="token-de-verificacion-para-webhooks-meta"
# OBLIGATORIO para recibir mensajes: con lo que Meta firma cada POST del webhook
# (X-Hub-Signature-256). Meta → App → Configuración → Básica → Clave secreta.
# Sin esta variable el webhook rechaza TODO con 403 — falla cerrado a propósito,
# ver MetaSignatureGuard.
META_APP_SECRET="clave-secreta-de-la-app-de-meta"
# Pendientes de configurar al conectar Meta/WhatsApp:
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_ID=""
# WHATSAPP_WABA_ID=""  # cuenta Business, necesaria para listar plantillas de Meta

# Token de página (System User, permiso `leads_retrieval`) con el que
# LeadAdsGraphService resuelve un leadgen_id contra Graph API — sin esto el
# webhook de Lead Ads (/webhooks/meta) recibe el aviso pero no puede obtener
# nombre/teléfono del formulario, y el lead queda logueado y descartado.
# Ver META_INTEGRATION_GUIDE.md §6 para cómo generarlo.
PAGE_ACCESS_TOKEN=""
CORS_ORIGINS="http://localhost:4200"

# Líneas adicionales: IDs y WABA se administran en /lineas-whatsapp.
# Los nombres siguientes se guardan como referencia; los tokens quedan solo en el servidor.
# WHATSAPP_CLIMON_TOKEN=""
# WHATSAPP_RECEPCION_TOKEN=""
# WHATSAPP_CENTRO_TOKEN=""
# Ver docs/lineas-whatsapp.md. El acuse comercial NO se aplica a recepción.

# ── Acuse automático fuera de horario (opcional) ──────────────────────
# Sin AUTORESPUESTA_TEXTO la función queda APAGADA: no hay mensaje por defecto
# a propósito, porque debe incluir el teléfono de urgencias de la clínica y un
# texto inventado mandaría a un paciente urgente a un número equivocado.
# El acuse cabe en la ventana de 24h que abre el mensaje del paciente, así que
# no necesita plantilla aprobada y no tiene coste.
AUTORESPUESTA_TEXTO="Gracias por escribir a Clínica Montalvo. Este es un mensaje automático: en este momento no hay nadie atendiendo. Te responderemos [CUÁNDO]. Si es una urgencia, llama al [TELÉFONO]."
# Días y horas de atención. L M X J V S D, rangos con guion.
AUTORESPUESTA_HORARIO="L-V:08:00-18:00,S:08:00-12:00"
# Zona horaria de la CLÍNICA, no del servidor (el VPS está en EE. UU.).
AUTORESPUESTA_ZONA="America/La_Paz"
# Horas antes de volver a mandar un acuse a la misma conversación.
AUTORESPUESTA_ESPERA_HORAS=12
# Botones de respuesta rápida del acuse (fase 2). Máximo 3, hasta 20 caracteres
# cada uno, sin repetir. Si no cumple, el acuse sale como texto plano: un
# interactivo malformado lo rechaza Meta entero y el paciente no recibe nada.
# La elección vuelve por el webhook como un mensaje normal con el título tocado.
AUTORESPUESTA_BOTONES="Agendar una cita|Ver resultados|Otra consulta"

# Mensaje que se manda UNA sola vez por conversación (para siempre, no con la
# ventana de AUTORESPUESTA_ESPERA_HORAS) cuando el paciente toca uno de los
# botones de arriba — sin esto, el clic no dispara nada más que dejar el
# título del botón en el chat como si el paciente lo hubiera escrito. Igual
# que AUTORESPUESTA_TEXTO, sin esta variable la función queda apagada.
AUTORESPUESTA_PEDIDO_DATOS="Para atenderte mejor, ¿nos podrías indicar tu nombre completo y tu edad? En cuanto podamos, te atenderemos."
# Si la paciente pregunta dónde queda la clínica, el CRM le manda el pin de
# ubicación (ver ubicacion-clinica.ts). Encendido por defecto; "off" lo apaga.
# UBICACION_AUTOMATICA=off

# ── Notificaciones Web Push (VAPID) ───────────────────────────────────────────
# Avisan al teléfono de la agente cuando escribe una paciente y el CRM está
# cerrado. Se genera UNA vez y no se cambia: cada par de llaves nuevo invalida
# todas las suscripciones existentes, y las agentes dejan de recibir avisos sin
# que nada lo indique (verían el permiso concedido en el navegador igualmente).
#
#   npx web-push generate-vapid-keys
#
# Sin estas dos variables la función queda apagada a propósito. La privada es un
# secreto: quien la tenga puede mandar notificaciones en nombre de la clínica.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contacto que exige el estándar; se le manda al servicio de push del navegador.
VAPID_SUBJECT="mailto:soporte@clinicamontalvo.com"

# ── Excel reales de comisiones (solo para pruebas) ───────────────────────────
# Carpeta con los .xlsx que exporta administración (octubre.xlsx, noviembre.xlsx,
# diciembre.xlsx, febrero.xlsx, marzo.xlsx / enero.xlsx de 2026).
#
# NO se versionan: llevan nombres de pacientes y las cifras que se pagaron. Cada
# máquina los tiene donde quiere, por eso la ruta se configura aquí.
#
# Sin esto, `verificacion-diciembre.integracion.spec.ts` y parte de
# `clasificador.spec.ts` se OMITEN — avisan por consola, pero salen en verde sin
# comprobar nada. Es la única prueba que compara el motor contra lo que
# administración pagó de verdad, así que conviene definirlas antes de tocar
# comisiones.
CRM_EXCELS_2025_DIR=
CRM_EXCELS_2026_DIR=

# R2 opcional: sin estas variables, media/archivos queda deshabilitado.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# ── Entrega de resultados ────────────────────────────────────────────────────
# Portal de resultados: vive en el MISMO servidor, se habla por loopback.
PORTAL_RESULTADOS_URL=http://127.0.0.1:3010
PORTAL_RESULTADOS_TOKEN=
# Solo para mostrar el enlace en el historial del chat; el paciente lo recibe
# por el botón de la plantilla, no por este texto.
PORTAL_RESULTADOS_PUBLICO=https://resultados.107.175.132.15.nip.io/resultados

# Dirección pública de ESTA API. Meta descarga desde aquí las imágenes de
# cabecera de plantillas (assets/cabeceras/<plantilla>.jpg, en
# /publico/cabeceras/). Sin ella, ninguna plantilla con imagen se ofrece.
CRM_URL_PUBLICA=https://crm.107.175.132.15.nip.io
# Aviso a la landing pública (Next.js en Vercel) al publicar o editar una
# promoción o el directorio médico: deja de servir lo guardado al instante. El
# secreto es el mismo que CRM_REVALIDAR_SECRETO en las variables de Vercel. Sin
# los dos, la landing se renueva sola cada 5 minutos.
LANDING_REVALIDAR_URL=https://clinicamontalvo.vercel.app/api/revalidar
LANDING_REVALIDAR_SECRETO=
# Días sin ningún mensaje tras los que una conversación se cierra sola (sale de
# las pestañas de trabajo; se reabre si la paciente escribe). 30 si se omite.
CONVERSACIONES_CIERRE_DIAS=30
# Línea de WhatsApp por la que salen los avisos. Quien tenga acceso a ESTA
# línea puede entregar resultados: el permiso es la membresía, no el rango.
RESULTADOS_LINEA_ID=
# Plantilla aprobada en Meta. Cuerpo SIN variables y botón URL dinámico.
RESULTADOS_PLANTILLA=montalvo_informe_disponible
RESULTADOS_PLANTILLA_IDIOMA=es
# Interacciones de WhatsApp (botones, listas, menú de atención, tarjetas de
# promoción, «Atención»). Apagadas si se omite. La clave: 32 bytes en base64,
# generada UNA vez en el servidor (cambiarla deja ilegibles las ofertas guardadas).
# WHATSAPP_INTERACCIONES=on
# WHATSAPP_INTERACCIONES_KEY=
# WHATSAPP_INTERACCIONES_RETENCION=on
# Líneas encendidas: ids de LineaWhatsapp separados por coma. Solo esas se comportan
# con interacciones (menú, Flows, «Atención»); las demás, como con la bandera apagada.
# Falla CERRADO: vacía o ausente = NINGUNA. Todas = escribir «todas».
# WHATSAPP_INTERACCIONES_LINEAS=

# Agenda de ScriptCase (montalvo-vps): lectura de médicos y horas libres para la
# landing. Usuario MySQL de SOLO LECTURA (columnas públicas de `medicos` y
# `vista_horas_libres`), TLS verificado contra la CA del propio MySQL. Apagada
# salvo AGENDA_VPS_LECTURA=on. La identidad TLS es el CN del certificado del
# servidor MySQL (no tiene SAN/IP). Nunca escribe en el legado.
AGENDA_VPS_LECTURA=off
AGENDA_MYSQL_HOST=23.95.128.187
AGENDA_MYSQL_PUERTO=3306
AGENDA_MYSQL_USUARIO=crm_agenda_lectura
AGENDA_MYSQL_PASSWORD=
AGENDA_MYSQL_CA_ARCHIVO=/etc/crm-agenda/mysql-ca.pem
AGENDA_MYSQL_TLS_IDENTIDAD=MySQL_Server_8.0.44_Auto_Generated_Server_Certificate
# Reservas desde la landing: escriben en `para_agendar` como el formulario
# público de ScriptCase (PENDIENTE → comprobante → PAGADO, a verificar por caja).
# Usuario MySQL aparte, con permiso SOLO para ese INSERT y ese UPDATE.
AGENDA_VPS_RESERVAS=off
AGENDA_RESERVA_USUARIO=crm_agenda_reserva
AGENDA_RESERVA_PASSWORD=
# Firma la referencia del paso de pago (≥ 32 caracteres, aleatorio).
AGENDA_RESERVA_SECRETO=
# El mismo bot y chat de Telegram que avisa hoy ScriptCase.
AGENDA_TELEGRAM_TOKEN=
AGENDA_TELEGRAM_CHAT=
# De dónde se lee la imagen QR de `pagos_qr.Qr` (carpeta de ScriptCase).
AGENDA_QR_BASE_URL=http://23.95.128.187/clinicaw/_lib/file/img/
# Pantalla «Reservas» del CRM y bloque del chat: lee las reservas con los datos
# de la paciente y su comprobante. Usuario MySQL aparte, SOLO SELECT (lo crea
# scripts/agenda/crear-usuario-consulta.sh). Rutas con sesión: /agenda/reservas/*.
AGENDA_VPS_CONSULTA=off
AGENDA_CONSULTA_USUARIO=crm_agenda_consulta
AGENDA_CONSULTA_PASSWORD=
# Directorio médico del CRM: edita médicos, horarios (casillas de 30 min) y
# especialidades de la agenda, como los formularios de ScriptCase, sin borrar ni
# tocar el código de FileMaker. Usuario MySQL aparte (lo crea, con respaldo previo,
# scripts/agenda/crear-usuario-admin.sh). Rutas con sesión: /agenda/medicos/*.
AGENDA_VPS_ADMIN=off
AGENDA_ADMIN_USUARIO=crm_agenda_admin
AGENDA_ADMIN_PASSWORD=
# Flow de WhatsApp «Reservar una cita» (endpoint /whatsapp/flows/agenda): la llave
# PRIVADA RSA del endpoint, en el servidor (la genera y registra en Meta
# scripts/whatsapp/flow-llaves.sh). Sin ella el endpoint responde 503 y el Flow
# no se puede publicar. Usa también META_APP_SECRET (firma) y
# WHATSAPP_INTERACCIONES_KEY (sella el flow_token).
WHATSAPP_FLOWS_LLAVE_ARCHIVO=
WHATSAPP_FLOWS_LLAVE_CLAVE=
# Orígenes de la landing que pueden llamar a /publico/agenda/* (sin cookies).
CORS_ORIGINS_LANDING=https://clinicamontalvo.vercel.app
