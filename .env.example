DATABASE_URL="postgresql://usuario:password@localhost:5433/crm?schema=public"
PORT=3001
JWT_SECRET="generar-un-secreto-largo-y-aleatorio"
COMISION_PORCENTAJE=5
META_VERIFY_TOKEN="token-de-verificacion-para-webhooks-meta"
# OBLIGATORIO para recibir mensajes: con lo que Meta firma cada POST del webhook
# (X-Hub-Signature-256). Meta → App → Configuración → Básica → Clave secreta.
# Sin esta variable el webhook rechaza TODO con 403 — falla cerrado a propósito,
# ver WhatsappSignatureGuard.
META_APP_SECRET="clave-secreta-de-la-app-de-meta"
# Pendientes de configurar al conectar Meta/WhatsApp:
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_ID=""

# Token de página (System User, permiso `leads_retrieval`) con el que
# LeadAdsGraphService resuelve un leadgen_id contra Graph API — sin esto el
# webhook de Lead Ads (/webhooks/meta) recibe el aviso pero no puede obtener
# nombre/teléfono del formulario, y el lead queda logueado y descartado.
# Ver META_INTEGRATION_GUIDE.md §6 para cómo generarlo.
PAGE_ACCESS_TOKEN=""
CORS_ORIGINS="http://localhost:4200"

# ── Acuse automático fuera de horario (opcional) ──────────────────────
# Sin AUTORESPUESTA_TEXTO la función queda APAGADA: no hay mensaje por defecto
# a propósito, porque debe incluir el teléfono de urgencias de la clínica y un
# texto inventado mandaría a un paciente urgente a un número equivocado.
# El acuse cabe en la ventana de 24h que abre el mensaje del paciente, así que
# no necesita plantilla aprobada y no tiene coste.
AUTORESPUESTA_TEXTO="Gracias por escribir a Clínica Montalvo. Este es un mensaje automático: en este momento no hay nadie atendiendo. Te responderemos [CUÁNDO]. Si es una urgencia, llama al [TELÉFONO]."
# Días y horas de atención. L M X J V S D, rangos con guion.
AUTORESPUESTA_HORARIO="L-V:08:00-18:00,S:08:00-12:00"
# Zona horaria de la CLÍNICA, no del servidor (el VPS está en EE. UU.).
AUTORESPUESTA_ZONA="America/La_Paz"
# Horas antes de volver a mandar un acuse a la misma conversación.
AUTORESPUESTA_ESPERA_HORAS=12
# Botones de respuesta rápida del acuse (fase 2). Máximo 3, hasta 20 caracteres
# cada uno, sin repetir. Si no cumple, el acuse sale como texto plano: un
# interactivo malformado lo rechaza Meta entero y el paciente no recibe nada.
# La elección vuelve por el webhook como un mensaje normal con el título tocado.
AUTORESPUESTA_BOTONES="Agendar una cita|Ver resultados|Otra consulta"

# Mensaje que se manda UNA sola vez por conversación (para siempre, no con la
# ventana de AUTORESPUESTA_ESPERA_HORAS) cuando el paciente toca uno de los
# botones de arriba — sin esto, el clic no dispara nada más que dejar el
# título del botón en el chat como si el paciente lo hubiera escrito. Igual
# que AUTORESPUESTA_TEXTO, sin esta variable la función queda apagada.
AUTORESPUESTA_PEDIDO_DATOS="Para atenderte mejor, ¿nos podrías indicar tu nombre completo y tu edad? En cuanto podamos, te atenderemos."

# ── Notificaciones Web Push (VAPID) ───────────────────────────────────────────
# Avisan al teléfono de la agente cuando escribe una paciente y el CRM está
# cerrado. Se genera UNA vez y no se cambia: cada par de llaves nuevo invalida
# todas las suscripciones existentes, y las agentes dejan de recibir avisos sin
# que nada lo indique (verían el permiso concedido en el navegador igualmente).
#
#   npx web-push generate-vapid-keys
#
# Sin estas dos variables la función queda apagada a propósito. La privada es un
# secreto: quien la tenga puede mandar notificaciones en nombre de la clínica.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contacto que exige el estándar; se le manda al servicio de push del navegador.
VAPID_SUBJECT="mailto:soporte@clinicamontalvo.com"
