{
  "name": "crm-backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "npm run check:skills && nest build",
    "check:skills": "node scripts/verificar-skills.mjs",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integracion:preparar": "psql -h localhost -p 5433 -U crm_app -d postgres -c \"DROP DATABASE IF EXISTS crm_test;\" -c \"CREATE DATABASE crm_test;\" && DATABASE_URL=\"postgresql://crm_app:crm_dev_local@localhost:5433/crm_test?schema=public\" prisma migrate deploy",
    "test:integracion": "jest --runInBand --testPathIgnorePatterns '/node_modules/' --testPathPattern '\\.integracion\\.spec\\.ts$'"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.0.6",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^5.20.0",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.16.0",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.5.4",
    "xlsx": "^0.18.5"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.integracion\\.spec\\.ts$"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.ts"
    ],
    "testEnvironment": "node"
  }
}
