{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Nest elimina dist antes de compilar: la caché debe desaparecer con su salida.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    // Ayudas que solo usan las suites (p. ej. `categorias.de-prueba.ts`).
    "**/*.de-prueba.ts",
    "prisma.config.ts"
  ]
}
