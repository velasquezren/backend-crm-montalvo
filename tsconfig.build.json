{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Nest elimina dist antes de compilar: la caché debe desaparecer con su salida.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    "prisma.config.ts"
  ]
}
