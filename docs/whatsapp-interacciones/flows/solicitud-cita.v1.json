{
  "version": "7.3",
  "screens": [
    {
      "id": "MOTIVO",
      "title": "Solicitar una cita",
      "data": {},
      "sensitive": ["especialidad"],
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Son dos preguntas. Después, recepción te escribirá por este chat para acordar el día y la hora."
          },
          {
            "type": "RadioButtonsGroup",
            "name": "especialidad",
            "label": "¿Para qué es la cita?",
            "required": true,
            "data-source": [
              { "id": "GINECOLOGIA", "title": "Ginecología" },
              { "id": "MATERNIDAD", "title": "Maternidad" },
              { "id": "REPRODUCCION_ASISTIDA", "title": "Reproducción asistida" },
              { "id": "OTRA", "title": "Otra especialidad" },
              { "id": "ORIENTACION", "title": "No sé, necesito orientación" }
            ]
          },
          {
            "type": "TextCaption",
            "text": "¿Prefieres escribirnos? Cierra este formulario y cuéntanos en el chat."
          },
          {
            "type": "Footer",
            "label": "Continuar",
            "on-click-action": {
              "name": "navigate",
              "next": { "type": "screen", "name": "PREFERENCIA" },
              "payload": {}
            }
          }
        ]
      }
    },
    {
      "id": "PREFERENCIA",
      "title": "Solicitar una cita",
      "terminal": true,
      "success": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "RadioButtonsGroup",
            "name": "cuando",
            "label": "¿Cuándo te vendría bien?",
            "required": true,
            "data-source": [
              { "id": "LO_ANTES_POSIBLE", "title": "Lo antes posible" },
              { "id": "PROXIMA_SEMANA", "title": "La próxima semana" },
              { "id": "MAS_ADELANTE", "title": "Más adelante" }
            ]
          },
          {
            "type": "RadioButtonsGroup",
            "name": "horario",
            "label": "¿En qué horario?",
            "required": true,
            "data-source": [
              { "id": "MANANA", "title": "Por la mañana" },
              { "id": "TARDE", "title": "Por la tarde" },
              { "id": "INDISTINTO", "title": "Cualquier horario" }
            ]
          },
          {
            "type": "TextCaption",
            "text": "Esto es una solicitud: todavía no reserva la cita. Recepción te propondrá un día y una hora por este chat."
          },
          {
            "type": "Footer",
            "label": "Enviar solicitud",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "flow_version": "solicitud-cita.v1",
                "especialidad": "${screen.MOTIVO.form.especialidad}",
                "cuando": "${form.cuando}",
                "horario": "${form.horario}"
              }
            }
          }
        ]
      }
    }
  ]
}
